import NRR.SingularHomologySimplicial

noncomputable section
open CategoryTheory Limits AlgebraicTopology Simplicial Opposite
namespace NRR.SingularHomology
variable {X : TopCat.{0}} {ι : Type*} {U : ι → Set X}
/-- The simplicial subcomplex of singular simplices whose image is contained
in `V`. -/
noncomputable abbrev smallSubcomplexOfSet (V : Set X) :
    (TopCat.toSSet.obj X).Subcomplex :=
  SSet.Subcomplex.range
    (TopCat.toSSet.map
      (TopCat.ofHom (X := V) ⟨Subtype.val, by fun_prop⟩))

lemma mem_smallSubcomplexOfSet_iff (V : Set X) {n : ℕ}
    (s : TopCat.toSSet.obj X _⦋n⦌) :
    s ∈ (smallSubcomplexOfSet V).obj _ ↔
      Set.range (TopCat.toSSetObjEquiv _ _ s) ⊆ V := by
  simp only [smallSubcomplexOfSet, Subpresheaf.range_obj, Set.mem_range]
  refine ⟨?_, fun h ↦ ?_⟩
  · rintro ⟨s, rfl⟩
    obtain ⟨f, rfl⟩ := (TopCat.toSSetObjEquiv _ _).symm.surjective s
    change Set.range (Subtype.val ∘ f) ⊆ V
    rintro _ ⟨u, rfl⟩
    simp
  · obtain ⟨f, rfl⟩ := (TopCat.toSSetObjEquiv _ _).symm.surjective s
    exact ⟨(TopCat.toSSetObjEquiv _ _).symm
      ⟨fun x ↦ ⟨f x, h (by simp)⟩, by fun_prop⟩, rfl⟩

lemma smallSubcomplexOfSet_inter (V₁ V₂ : Set X) :
    smallSubcomplexOfSet (V₁ ∩ V₂) =
      smallSubcomplexOfSet V₁ ⊓ smallSubcomplexOfSet V₂ := by
  apply Subpresheaf.ext
  funext n
  change (smallSubcomplexOfSet (V₁ ∩ V₂)).obj (op ⦋n.unop.len⦌) =
    (smallSubcomplexOfSet V₁ ⊓ smallSubcomplexOfSet V₂).obj (op ⦋n.unop.len⦌)
  apply Set.ext
  intro s
  simp only [mem_smallSubcomplexOfSet_iff, Set.subset_inter_iff,
    Subpresheaf.min_obj, Set.mem_inter_iff]

/-- The simplicial subcomplex generated by singular simplices whose image is
contained in one member of `U`. -/
noncomputable def smallSubcomplex (U : ι → Set X) :
    (TopCat.toSSet.obj X).Subcomplex :=
  ⨆ i, smallSubcomplexOfSet (U i)

lemma smallSubcomplex_bool (U : Bool → Set X) :
    smallSubcomplex U =
      smallSubcomplexOfSet (U false) ⊔ smallSubcomplexOfSet (U true) := by
  dsimp [smallSubcomplex]
  refine le_antisymm ?_ ?_
  · simp
  · simp only [sup_le_iff]
    exact ⟨le_iSup (fun i ↦ smallSubcomplexOfSet (U i)) false,
      le_iSup (fun i ↦ smallSubcomplexOfSet (U i)) true⟩

lemma mem_smallSubcomplex_iff {n : ℕ}
    (s : TopCat.toSSet.obj X _⦋n⦌) :
    s ∈ (smallSubcomplex U).obj _ ↔
      ∃ i, Set.range (TopCat.toSSetObjEquiv _ _ s) ⊆ U i := by
  simp only [smallSubcomplex, Subpresheaf.iSup_obj, Set.mem_iUnion,
    mem_smallSubcomplexOfSet_iff]

lemma mem_smallSubcomplex_iff_exists_lift {n : ℕ}
    (s : TopCat.toSSet.obj X _⦋n⦌) :
    s ∈ (smallSubcomplex U).obj _ ↔
      ∃ (i : ι) (t : TopCat.toSSet.obj (TopCat.of (U i)) _⦋n⦌),
        (TopCat.toSSet.map
          (TopCat.ofHom ⟨Subtype.val, by fun_prop⟩)).app _ t = s := by
  rw [mem_smallSubcomplex_iff]
  refine exists_congr (fun i ↦ ⟨fun h ↦ ?_, ?_⟩)
  · obtain ⟨f, rfl⟩ := (TopCat.toSSetObjEquiv _ _).symm.surjective s
    exact ⟨(TopCat.toSSetObjEquiv _ _).symm
      ⟨fun x ↦ ⟨f x, h (by simp)⟩, by fun_prop⟩, rfl⟩
  · rintro ⟨t, rfl⟩
    obtain ⟨t, rfl⟩ := (TopCat.toSSetObjEquiv _ _).symm.surjective t
    rintro _ ⟨x, rfl⟩
    exact (t x).prop


variable (R : Type) [Ring R]
variable {X : TopCat.{0}} (A B : Set X)

/-! ### The subcomplex of small simplices -/

/-- The two subsets `A` and `B`, packaged as a family indexed by `Bool`. -/
def mvFamily : Bool → Set X := Bool.rec A B

@[simp] lemma mvFamily_false : mvFamily A B false = A := rfl
@[simp] lemma mvFamily_true : mvFamily A B true = B := rfl

/-- The subcomplex `S^{A,B}` of the singular simplicial set of `X` spanned by the simplices whose
image lies entirely in `A` or entirely in `B`. -/
def mvSubcomplex : (TopCat.toSSet.obj X).Subcomplex :=
  smallSubcomplex (mvFamily A B)

lemma mvSubcomplex_eq_sup :
    mvSubcomplex A B = smallSubcomplexOfSet A ⊔ smallSubcomplexOfSet B :=
  smallSubcomplex_bool _

lemma subcomplexOfSet_le_mvSubcomplex_left :
    smallSubcomplexOfSet A ≤ mvSubcomplex A B := by
  rw [mvSubcomplex_eq_sup]; exact le_sup_left

lemma subcomplexOfSet_le_mvSubcomplex_right :
    smallSubcomplexOfSet B ≤ mvSubcomplex A B := by
  rw [mvSubcomplex_eq_sup]; exact le_sup_right

/-- The chain complex `C^{A,B}_*(X)` of small chains. -/
abbrev mvSmallComplex : ChainComplex (ModuleCat R) ℕ := CsingSSet R (mvSubcomplex A B)

/-- The inclusion `C^{A,B}_*(X) ⟶ C_*(X)`. -/
def mvSmallIncl : mvSmallComplex (R := R) A B ⟶ Csing R X :=
  simplicialChainMap R (mvSubcomplex A B).ι

/-! ### The four spaces and the maps between them -/

/-- The inclusion `A ∩ B ⟶ A`. -/
def mvInclLeft : TopCat.of (A ∩ B : Set X) ⟶ TopCat.of A :=
  TopCat.ofHom (ContinuousMap.inclusion Set.inter_subset_left)

/-- The inclusion `A ∩ B ⟶ B`. -/
def mvInclRight : TopCat.of (A ∩ B : Set X) ⟶ TopCat.of B :=
  TopCat.ofHom (ContinuousMap.inclusion Set.inter_subset_right)

@[simp] lemma mvInclLeft_comp : mvInclLeft A B ≫ subIncl A = subIncl (A ∩ B) := rfl
@[simp] lemma mvInclRight_comp : mvInclRight A B ≫ subIncl B = subIncl (A ∩ B) := rfl

/-- `Sing(A ∩ B) ⟶ Sing A`. -/
abbrev mvQa : TopCat.toSSet.obj (TopCat.of (A ∩ B : Set X)) ⟶
    TopCat.toSSet.obj (TopCat.of A) := TopCat.toSSet.map (mvInclLeft A B)

/-- `Sing(A ∩ B) ⟶ Sing B`. -/
abbrev mvQb : TopCat.toSSet.obj (TopCat.of (A ∩ B : Set X)) ⟶
    TopCat.toSSet.obj (TopCat.of B) := TopCat.toSSet.map (mvInclRight A B)

/-- `Sing A ⟶ S^{A,B}`. -/
def mvPa : TopCat.toSSet.obj (TopCat.of A) ⟶ (mvSubcomplex A B : SSet.{0}) :=
  Subpresheaf.lift (TopCat.toSSet.map (subIncl A)) (subcomplexOfSet_le_mvSubcomplex_left A B)

/-- `Sing B ⟶ S^{A,B}`. -/
def mvPb : TopCat.toSSet.obj (TopCat.of B) ⟶ (mvSubcomplex A B : SSet.{0}) :=
  Subpresheaf.lift (TopCat.toSSet.map (subIncl B)) (subcomplexOfSet_le_mvSubcomplex_right A B)

@[reassoc (attr := simp)]
lemma mvPa_ι : mvPa A B ≫ (mvSubcomplex A B).ι = TopCat.toSSet.map (subIncl A) := rfl

@[reassoc (attr := simp)]
lemma mvPb_ι : mvPb A B ≫ (mvSubcomplex A B).ι = TopCat.toSSet.map (subIncl B) := rfl

/-! ### Injectivity -/

/-- If `f` is injective then so is every component of `Sing f`. -/
lemma injective_toSSet_map_app {Y Z : TopCat.{0}} (f : Y ⟶ Z) (hf : Function.Injective f)
    (n : ℕ) : Function.Injective ((TopCat.toSSet.map f).app (op ⦋n⦌)) := by
  intro s t h
  apply (TopCat.toSSetObjEquiv Y _).injective
  ext x
  apply hf
  exact congrArg (fun z => TopCat.toSSetObjEquiv Z _ z x) h

lemma injective_mvQb_app (n : ℕ) : Function.Injective ((mvQb A B).app (op ⦋n⦌)) := by
  refine injective_toSSet_map_app _ (fun u v h => ?_) n
  have h' : (u : X) = (v : X) := congrArg (fun w : (B : Set X) => (w : X)) h
  exact Subtype.ext h'

lemma injective_mvPa_app (n : ℕ) : Function.Injective ((mvPa A B).app (op ⦋n⦌)) := by
  intro u v h
  exact injective_toSSet_map_app (subIncl A) Subtype.val_injective n (congrArg Subtype.val h)

lemma injective_mvPb_app (n : ℕ) : Function.Injective ((mvPb A B).app (op ⦋n⦌)) := by
  intro u v h
  exact injective_toSSet_map_app (subIncl B) Subtype.val_injective n (congrArg Subtype.val h)

/-! ### The Mayer–Vietoris short complex -/

lemma mvQa_comp_mvPa : mvQa A B ≫ mvPa A B = mvQb A B ≫ mvPb A B := by
  refine (cancel_mono (mvSubcomplex A B).ι).1 ?_
  rw [Category.assoc, Category.assoc, mvPa_ι, mvPb_ι, ← Functor.map_comp, ← Functor.map_comp,
    mvInclLeft_comp, mvInclRight_comp]

/-- The Mayer–Vietoris short complex
`C_*(A ∩ B) ⟶ C_*(A) ⊞ C_*(B) ⟶ C^{A,B}_*(X)`. -/
def mvSC : ShortComplex (ChainComplex (ModuleCat R) ℕ) :=
  mvShortComplex (R := R) (mvQa A B) (mvQb A B) (mvPa A B) (mvPb A B) (mvQa_comp_mvPa A B)

lemma mvSC_X₃ : (mvSC (R := R) A B).X₃ = mvSmallComplex (R := R) A B := rfl

lemma mvSC_f_eq : (mvSC (R := R) A B).f =
    biprod.lift (simplicialChainMap R (mvQa A B))
      (simplicialChainMap R (mvQb A B)) := rfl

lemma mvSC_g_eq : (mvSC (R := R) A B).g =
    biprod.desc (simplicialChainMap R (mvPa A B))
      (-simplicialChainMap R (mvPb A B)) := rfl

@[reassoc]
lemma mvSC_f_fst : (mvSC (R := R) A B).f ≫
    (biprod.fst : Csing R (TopCat.of A) ⊞ Csing R (TopCat.of B) ⟶ Csing R (TopCat.of A)) =
      CsingMap R (mvInclLeft A B) := by
  change (biprod.lift
      (simplicialChainMap R (mvQa A B))
      (simplicialChainMap R (mvQb A B))) ≫
        (biprod.fst : Csing R (TopCat.of A) ⊞ Csing R (TopCat.of B) ⟶ Csing R (TopCat.of A)) =
    simplicialChainMap R (mvQa A B)
  exact biprod.lift_fst _ _

lemma mvSmallIncl_def :
    mvSmallIncl (R := R) A B = simplicialChainMap R (mvSubcomplex A B).ι := rfl

lemma mvPa_smallIncl :
    simplicialChainMap R (mvPa A B) ≫ mvSmallIncl (R := R) A B =
      CsingMap R (subIncl A) :=
  ((CsingSSetFunctor R).map_comp
    (mvPa A B) (mvSubcomplex A B).ι).symm

lemma mvPb_smallIncl :
    simplicialChainMap R (mvPb A B) ≫ mvSmallIncl (R := R) A B =
      CsingMap R (subIncl B) :=
  ((CsingSSetFunctor R).map_comp
    (mvPb A B) (mvSubcomplex A B).ι).symm

/-- Every small simplex comes from `A` or from `B`. -/
lemma mvCover (n : ℕ) (d : (mvSubcomplex A B : SSet.{0}) _⦋n⦌) :
    (∃ x, (mvPa A B).app (op ⦋n⦌) x = d) ∨ (∃ y, (mvPb A B).app (op ⦋n⦌) y = d) := by
  obtain ⟨i, t, ht⟩ := (mem_smallSubcomplex_iff_exists_lift (U := mvFamily A B) d.1).1 d.2
  match i with
  | false => exact Or.inl ⟨t, Subtype.ext ht⟩
  | true => exact Or.inr ⟨t, Subtype.ext ht⟩

/-- A simplex lying both in `A` and in `B` lies in `A ∩ B`. -/
lemma mvInter (n : ℕ) (x : TopCat.toSSet.obj (TopCat.of A) _⦋n⦌)
    (y : TopCat.toSSet.obj (TopCat.of B) _⦋n⦌)
    (hxy : (mvPa A B).app (op ⦋n⦌) x = (mvPb A B).app (op ⦋n⦌) y) :
    ∃ z, (mvQb A B).app (op ⦋n⦌) z = y := by
  have hval : (TopCat.toSSet.map (subIncl A)).app (op ⦋n⦌) x =
      (TopCat.toSSet.map (subIncl B)).app (op ⦋n⦌) y := congrArg Subtype.val hxy
  have hmemA : (TopCat.toSSet.map (subIncl B)).app (op ⦋n⦌) y ∈
      (smallSubcomplexOfSet A).obj (op ⦋n⦌) := ⟨x, hval⟩
  have hmemB : (TopCat.toSSet.map (subIncl B)).app (op ⦋n⦌) y ∈
      (smallSubcomplexOfSet B).obj (op ⦋n⦌) := ⟨y, rfl⟩
  have hmem : (TopCat.toSSet.map (subIncl B)).app (op ⦋n⦌) y ∈
      (smallSubcomplexOfSet (A ∩ B)).obj (op ⦋n⦌) := by
    rw [smallSubcomplexOfSet_inter]
    exact ⟨hmemA, hmemB⟩
  obtain ⟨z, hz⟩ := hmem
  have hcomp : mvQb A B ≫ TopCat.toSSet.map (subIncl B) =
      TopCat.toSSet.map (subIncl (A ∩ B)) := by
    rw [← Functor.map_comp, mvInclRight_comp]
  refine ⟨z, injective_toSSet_map_app (subIncl B) Subtype.val_injective n ?_⟩
  rw [← hz]
  exact congrArg (fun (φ : TopCat.toSSet.obj (TopCat.of (A ∩ B : Set X)) ⟶ TopCat.toSSet.obj X) =>
    φ.app (op ⦋n⦌) z) hcomp

/-- **The Mayer–Vietoris short exact sequence of chain complexes.**
`0 ⟶ C_*(A ∩ B) ⟶ C_*(A) ⊞ C_*(B) ⟶ C^{A,B}_*(X) ⟶ 0`. -/
theorem mvSC_shortExact : (mvSC (R := R) A B).ShortExact :=
  mvShortComplex_shortExact (R := R) (mvQa_comp_mvPa A B) (injective_mvQb_app A B)
    (injective_mvPa_app A B) (injective_mvPb_app A B) (mvCover A B) (mvInter A B)

/-- The explicit degreewise splitting underlying `mvSC_shortExact (R := R)`.  Naming this splitting lets
contravariant additive functors, in particular `Hom(-, G)`, reuse the stronger input rather than
only the resulting short exactness. -/
def mvSCSplitting (n : ℕ) : ShortComplex.Splitting
    ((mvSC (R := R) A B).map
      (HomologicalComplex.eval (ModuleCat R) (ComplexShape.down ℕ) n)) :=
  mvSplitting (R := R) (mvQa A B) (mvQb A B) (mvPa A B) (mvPb A B) (mvQa_comp_mvPa A B) n
    (injective_mvQb_app A B n) (injective_mvPa_app A B n) (injective_mvPb_app A B n)
    (mvCover A B n) (mvInter A B n)


end NRR.SingularHomology
